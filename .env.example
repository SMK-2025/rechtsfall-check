# Öffentliche Basis-URL, lokal ohne abschließenden Slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Produktion: beide Werte auf https://rechtsfall-check.de setzen.

# Mit `openssl rand -base64 32` erzeugen, niemals einchecken.
BETTER_AUTH_SECRET=

# Railway PostgreSQL. In Vercel die öffentliche DATABASE_URL des Railway-Postgres-Dienstes verwenden.
DATABASE_URL=
DATABASE_SSL=true

# Transaktionale Authentifizierungs- und Systemmails.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=service@rechtsfall-check.de
SENDGRID_FROM_NAME=Rechtsfall-Check.de
SENDGRID_REPLY_TO=service@rechtsfall-check.de

# Wird bei Verbindung eines privaten Vercel-Blob-Stores automatisch gesetzt.
BLOB_READ_WRITE_TOKEN=

# Pay-per-Case Checkout (19 EUR brutto inklusive 19 % deutscher Umsatzsteuer)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# In Stripe einen inklusiven Steuersatz mit 19 % und Land DE anlegen.
# Test- und Live-Modus besitzen jeweils eine eigene txr_... ID.
STRIPE_TAX_RATE_ID=
# Einmalige Checkout-Zahlungen erzeugen automatisch eine Stripe-Rechnung.
# Der Webhook muss Checkout-, Refund- und Invoice-Ereignisse empfangen.

# Dokumentextraktion nutzt standardmäßig denselben freigegebenen OpenAI-Zugang
# wie die Fallanalyse. "auto" und "openai" sind zulässig.
OCR_PROVIDER=openai
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_API_KEY=
# Railway-Scanner: Endpoint endet auf /scan. API-Key muss mit SCANNER_API_KEY
# im isolierten Railway-Dienst identisch sein.
# In Produktion erst nach angebundenem Scanner auf true setzen. Dann werden Uploads bei
# Ausfall oder nicht eindeutig sauberem Ergebnis fail-closed abgewiesen.
REQUIRE_MALWARE_SCAN=false
LEGAL_KNOWLEDGE_PROVIDER=disabled
LEGAL_CONTENT_VERSION=LEGAL_REVIEW_REQUIRED-unapproved-0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Die KI analysiert Falldaten und – nach ausdrücklicher Einwilligung – PDF-/Bildinhalte.
# Keine Schlüssel oder Dokumentinhalte in Logs schreiben.
ALLOW_UNPAID_ANALYSIS=false
DATA_RETENTION_DAYS=30
# Maximal pro täglichem Lauf verarbeitete Fälle und Konten (1–100).
RETENTION_BATCH_SIZE=25
# Kommagetrennte Login-Adressen für die geschützte Betriebsansicht /betrieb.
ADMIN_EMAILS=mk@media-online-innovations.group
# Starkes Geheimnis für den geplanten Aufbewahrungs-/Löschjob.
CRON_SECRET=

# Zieladresse für technische Systemalarme. Alarmmails enthalten keine Fallinhalte.
ALERT_EMAIL=mk@media-online-innovations.group
