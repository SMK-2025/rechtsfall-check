# Öffentliche Basis-URL, lokal ohne abschließenden Slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Mit `openssl rand -base64 32` erzeugen, niemals einchecken.
BETTER_AUTH_SECRET=

# GitHub OAuth App; Callback: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Neon PostgreSQL (gepoolte Serverless-Verbindung).
DATABASE_URL=

# Wird bei Verbindung eines privaten Vercel-Blob-Stores automatisch gesetzt.
BLOB_READ_WRITE_TOKEN=

# Provider erst nach Datenschutz-, Sicherheits- und juristischer Freigabe aktivieren.
OCR_PROVIDER=disabled
OCR_API_ENDPOINT=
OCR_API_KEY=
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_API_KEY=
LEGAL_KNOWLEDGE_PROVIDER=disabled
LEGAL_CONTENT_VERSION=LEGAL_REVIEW_REQUIRED-unapproved-mvp-0
DATA_RETENTION_DAYS=30
